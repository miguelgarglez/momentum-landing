---
import FAQ from '../components/landing/FAQ.astro';
import DownloadCTA from '../components/landing/DownloadCTA.astro';
import Footer from '../components/landing/Footer.astro';
import Header from '../components/landing/Header.astro';
import Hero from '../components/landing/Hero.astro';
import ScreensPreview from '../components/landing/ScreensPreview.astro';
import SolutionsStrip from '../components/landing/SolutionsStrip.astro';
import LandingLayout from '../layouts/LandingLayout.astro';
import { DOWNLOAD_RELEASE_LATEST_URL, DOWNLOAD_RELEASES_URL, landingContent } from '../data/landing';

const { meta, header, hero, solutions, screens, download, faq, footer } = landingContent;
---

<LandingLayout title={meta.title} description={meta.description}>
  <Header brand={header.brand} navItems={header.navItems} cta={header.cta} />
  <Hero content={hero} featuredScreen={screens.items[0]} />
  <SolutionsStrip content={solutions} />
  <ScreensPreview content={screens} />
  <DownloadCTA content={download} latestReleaseUrl={DOWNLOAD_RELEASE_LATEST_URL} releasesUrl={DOWNLOAD_RELEASES_URL} />
  <FAQ id="faq" title="Questions about the project?" subtitle="Quick answers for early users and portfolio reviewers." items={faq} />
  <Footer content={footer} />
</LandingLayout>
